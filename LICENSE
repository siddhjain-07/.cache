def stem(word):
    for suffix in ['ing', 'ed', 'ly', 'es', 's']:
        if word.endswith(suffix):
            return word[:-len(suffix)]
    return word
print(stem("running"))

# Q4
prefixes = ['un', 're', 'inter', 'pre', 'dis']
suffixes = ['ness', 'ed', 'al', 'ing', 'ly', 'tion']
def analyze_morphemes(word):
    morphemes = []
    rest = word
    for p in prefixes:
        if rest.startswith(p):
            morphemes.append((p+'-', 'bound'))
            rest = rest[len(p):]
            break
    for s in suffixes:
        if rest.endswith(s):
            morphemes.append((rest[:-len(s)], 'free'))
            morphemes.append(('-'+s, 'bound'))
            rest = None
            break
    if rest:
        morphemes.append((rest, 'free'))
    return morphemes
for word in ["unhappiness", "replayed", "international"]:
    print(f"{word}: {analyze_morphemes(word)}")

# Q5
def pos_tag(word):
    if word.endswith('ly'): return 'ADV'
    if word.endswith('ing'): return 'VBG'
    if word.endswith('ed'): return 'VBD'
    if word in ['the', 'a', 'an']: return 'DET'
    return 'NN'
sentence = "The cat quickly jumped"
print([(w, pos_tag(w)) for w in sentence.split()])

# Q6
import nltk
from nltk import CFG
from nltk.parse.chart import ChartParser
grammar_str = """
S -> NP VP
NP -> PRP | Det N | Det N PP
VP -> V NP | V NP PP
PP -> P NP
PRP -> 'I'
V -> 'saw'
Det -> 'the' | 'a'
N -> 'man' | 'telescope'
P -> 'with'
"""
cfg = CFG.fromstring(grammar_str)
parser = ChartParser(cfg)
sentence = "I saw the man with a telescope"
tokens = sentence.split()
trees = list(parser.parse(tokens))
num_parses = len(trees)
print(f"{sentence} - {'Syntactic' if num_parses > 1 else 'Semantic'} ambiguity ({num_parses} parse trees)")
for tree in trees:
    tree.pretty_print()

# Q7
from nltk import ngrams
text = "I love NLP and NLP is great"
tokens = text.split()
bigrams = list(ngrams(tokens, 2))
trigrams = list(ngrams(tokens, 3))
print(f"Bigrams: {bigrams}")
print(f"Trigrams: {trigrams}")
bigram_freq = Counter(bigrams)
total_bigrams = len(bigrams)
for bg, count in bigram_freq.items():
    prob = count / total_bigrams
    print(f"P{bg} = {count}/{total_bigrams} = {prob:.3f}")
sentences = ["I love NLP", "NLP is great", "I love programming"]
vocab = sorted(set(' '.join(sentences).split()))
bow = [[s.split().count(w) for w in vocab] for s in sentences]
print(vocab)
print(bow)
text = "I love NLP"
words = text.split()
n = 2
ngrams = [tuple(words[i:i+n]) for i in range(len(words)-n+1)]
print(f"Bigrams: {ngrams}")

