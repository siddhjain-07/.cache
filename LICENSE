# Q1
text = "Hello world. This is NLP. It is interesting."
sentences = re.split(r'[.!?]', text)
sentences = [s.strip() for s in sentences if s.strip()]
words = [w for s in sentences for w in s.split()]
print(f"Sentences: {len(sentences)}, Tokens: {len(words)}")

# Q2
sentence = "This is a sample sentence with some stopwords"
stopwords = ["is", "a", "with", "some"]
cleaned = ' '.join([w for w in sentence.split() if w.lower() not in stopwords])
print(cleaned)

# Q3
def stem(word):
    for suffix in ['ing', 'ed', 'ly', 'es', 's']:
        if word.endswith(suffix):
            return word[:-len(suffix)]
    return word
print(stem("running"))

# Q4
prefixes = ['un', 're', 'inter', 'pre', 'dis']
suffixes = ['ness', 'ed', 'al', 'ing', 'ly', 'tion']
def analyze_morphemes(word):
    morphemes = []
    rest = word
    for p in prefixes:
        if rest.startswith(p):
            morphemes.append((p+'-', 'bound'))
            rest = rest[len(p):]
            break
    for s in suffixes:
        if rest.endswith(s):
            morphemes.append((rest[:-len(s)], 'free'))
            morphemes.append(('-'+s, 'bound'))
            rest = None
            break
    if rest:
        morphemes.append((rest, 'free'))
    return morphemes
for word in ["unhappiness", "replayed", "international"]:
    print(f"{word}: {analyze_morphemes(word)}")

# Q5
def pos_tag(word):
    if word.endswith('ly'): return 'ADV'
    if word.endswith('ing'): return 'VBG'
    if word.endswith('ed'): return 'VBD'
    if word in ['the', 'a', 'an']: return 'DET'
    return 'NN'
sentence = "The cat quickly jumped"
print([(w, pos_tag(w)) for w in sentence.split()])

# Q6
sentence = "I saw the man with a telescope"
grammar = {
    'S': [['NP', 'VP']],
    'NP': [['PRP'], ['Det', 'N'], ['Det', 'N', 'PP']],
    'VP': [['V', 'NP'], ['V', 'NP', 'PP']],
    'PP': [['P', 'NP']],
    'PRP': ['I'],
    'V': ['saw'],
    'Det': ['the', 'a'],
    'N': ['man', 'telescope'],
    'P': ['with']
}
def count_parses(tokens, symbol, idx=0):
    if symbol in ['PRP', 'V', 'Det', 'N', 'P']:
        return [(1, idx + 1)] if idx < len(tokens) and tokens[idx] in grammar[symbol] else []
    results = []
    for rule in grammar.get(symbol, []):
        results.extend(parse_rule(tokens, rule, idx))
    return results

def parse_rule(tokens, rule, idx):
    if not rule:
        return [(1, idx)]
    first, rest = rule[0], rule[1:]
    results = []
    for left_count, next_idx in count_parses(tokens, first, idx):
        for right_count, final_idx in parse_rule(tokens, rest, next_idx):
            results.append((left_count * right_count, final_idx))
    return results

tokens = sentence.split()
num_parses = sum(
    count for count, idx in count_parses(tokens, 'S', 0)
    if idx == len(tokens)
)
print(f"{sentence} - {'Syntactic' if num_parses > 1 else 'Semantic'} ambiguity ({num_parses} parse trees)")

# Q7
sentences = ["I love NLP", "NLP is great", "I love programming"]
vocab = sorted(set(' '.join(sentences).split()))
bow = [[s.split().count(w) for w in vocab] for s in sentences]
print(vocab)
print(bow)

# Q8
doc = "cat cat dog bird cat"
words = doc.split()
tf = {w: words.count(w)/len(words) for w in set(words)}
print(tf)

# Q9
v1 = [1, 2, 3]
v2 = [4, 5, 6]
dot = sum(a*b for a,b in zip(v1,v2))
mag1 = math.sqrt(sum(a*a for a in v1))
mag2 = math.sqrt(sum(b*b for b in v2))
cosine = dot / (mag1 * mag2)
print(f"Cosine: {cosine}")

# Q11
classes = {'spam': 0.3, 'ham': 0.7}
word_probs = {'spam': {'free': 0.6, 'money': 0.5}, 'ham': {'free': 0.1, 'money': 0.05}}
sentence = "free money"
for c in classes:
    prob = classes[c]
    for w in sentence.split():
        prob *= word_probs[c].get(w, 0.01)
    print(f"{c}: {prob}")

# Q12
states = ['S', 'M']
trans = {'S': {'S': 0.7, 'M': 0.3}, 'M': {'S': 0.4, 'M': 0.6}}
emit = {'S': {'walk': 0.6, 'shop': 0.4}, 'M': {'walk': 0.3, 'shop': 0.7}}
print(trans, emit)
print("\nFinal Probability Table:")
for s1 in states:
    for s2 in states:
        prob = trans[s1][s2] * emit[s2]['walk']
        print(f"{s1} -> {s2} : {trans[s1][s2]} * {emit[s2]['walk']} = {prob}")

# Q13
bigrams = {('I', 'love'): 0.5, ('love', 'NLP'): 0.8, ('NLP', 'programming'): 0.3}
current = 'I'
text = [current]
import random
for _ in range(3):
    options = {b[1]: p for b, p in bigrams.items() if b[0] == current}
    if options:
        current = max(options, key=options.get)
        text.append(current)
print(' '.join(text))

# Q14
