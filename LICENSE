# Q16
grammar = {'S': [['NP', 'VP']], 'NP': [['Det', 'N']], 'VP': [['V', 'NP']], 'Det': ['the'], 'N': ['cat'], 'V': ['saw']}
def parse(tokens, symbol, grammar):
    if symbol in ['Det', 'N', 'V']:
        return tokens and tokens[0] in grammar[symbol]
    for rule in grammar.get(symbol, []):
        if all(isinstance(r, str) for r in rule):
            temp = tokens[:]
            valid = all(parse([temp.pop(0)] if temp else [], r, grammar) for r in rule)
            if valid and not temp: return True
    return False
print(parse(['the', 'cat', 'saw', 'the', 'cat'], 'S', grammar))

# Q17
def chunk(sentence):
    words = sentence.split()
    chunks = []
    i = 0
    while i < len(words):
        if pos_tag(words[i]) == 'DET' and i+1 < len(words):
            np = [words[i]]
            i += 1
            while i < len(words) and pos_tag(words[i]) in ['NN', 'ADV']:
                np.append(words[i])
                i += 1
            chunks.append(('NP', ' '.join(np)))
        else:
            i += 1
    return chunks
print(chunk("the quick cat"))

# Q18
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import Embedding, SimpleRNN, Dense
from tensorflow.keras.preprocessing.text import Tokenizer
from tensorflow.keras.preprocessing.sequence import pad_sequences
import nltk
nltk.download('movie_reviews', quiet=True)
from nltk.corpus import movie_reviews
import numpy as np

docs = [(list(movie_reviews.words(fileid)), category) 
        for category in movie_reviews.categories() 
        for fileid in movie_reviews.fileids(category)][:200]
texts = [' '.join(words) for words, _ in docs]
labels = [1 if cat == 'pos' else 0 for _, cat in docs]

tokenizer = Tokenizer(num_words=2000)
tokenizer.fit_on_texts(texts)
sequences = tokenizer.texts_to_sequences(texts)
X = pad_sequences(sequences, maxlen=100)
y = np.array(labels)

model = Sequential([
    Embedding(2000, 32, input_length=100),
    SimpleRNN(32),
    Dense(1, activation='sigmoid')
])
model.compile(optimizer='adam', loss='binary_crossentropy', metrics=['accuracy'])
model.fit(X, y, epochs=2, batch_size=32, validation_split=0.2, verbose=0)
print("RNN trained")

# Q19
import nltk
nltk.download('maxent_ne_chunker', quiet=True)
nltk.download('words', quiet=True)
nltk.download('punkt', quiet=True)
nltk.download('averaged_perceptron_tagger', quiet=True)

text = "Apple Inc. is located in California. Tim Cook is the CEO."
tokens = nltk.word_tokenize(text)
pos_tags = nltk.pos_tag(tokens)
entities = nltk.ne_chunk(pos_tags)
for entity in entities:
    if hasattr(entity, 'label'):
        print(entity.label(), ' '.join(c[0] for c in entity))
