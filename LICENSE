# Q9
v1 = [1, 2, 3]
v2 = [4, 5, 6]
dot = sum(a*b for a,b in zip(v1,v2))
mag1 = math.sqrt(sum(a*a for a in v1))
mag2 = math.sqrt(sum(b*b for b in v2))
cosine = dot / (mag1 * mag2)
print(f"Cosine: {cosine}")

# Q11
classes = {'spam': 0.3, 'ham': 0.7}
word_probs = {'spam': {'free': 0.6, 'money': 0.5}, 'ham': {'free': 0.1, 'money': 0.05}}
sentence = "free money"
for c in classes:
    prob = classes[c]
    for w in sentence.split():
        prob *= word_probs[c].get(w, 0.01)
    print(f"{c}: {prob}")

# Q12
states = ['S', 'M']
trans = {'S': {'S': 0.7, 'M': 0.3}, 'M': {'S': 0.4, 'M': 0.6}}
emit = {'S': {'walk': 0.6, 'shop': 0.4}, 'M': {'walk': 0.3, 'shop': 0.7}}
obs = ['walk', 'shop']
start_prob = {'S': 0.6, 'M': 0.4}
V = [{}]
path = {}
for s in states:
    V[0][s] = start_prob[s] * emit[s][obs[0]]
    path[s] = [s]
for t in range(1, len(obs)):
    V.append({})
    new_path = {}
    for curr_s in states:
        max_prob, best_prev = max((V[t-1][prev_s] * trans[prev_s][curr_s] * emit[curr_s][obs[t]], prev_s) for prev_s in states)
        V[t][curr_s] = max_prob
        new_path[curr_s] = path[best_prev] + [curr_s]
    path = new_path
final_prob, best_state = max((V[-1][s], s) for s in states)
print(f"Best path: {path[best_state]}, Prob: {final_prob}")

# Q13
bigrams = {('I', 'love'): 0.5, ('love', 'NLP'): 0.8, ('NLP', 'programming'): 0.3}
current = 'I'
text = [current]
import random
for _ in range(3):
    options = {b[1]: p for b, p in bigrams.items() if b[0] == current}
    if options:
        current = max(options, key=options.get)
        text.append(current)
print(' '.join(text))

